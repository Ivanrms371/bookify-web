---
import type { TenantService } from '@/types/tenant';
import { ClockIcon } from '@heroicons/react/24/outline';
import { ScissorsIcon } from '@heroicons/react/24/solid';
import { Button } from '@/components/ui/Button';
import { Heading } from '@/shared/components/typography/Heading';
import { Text } from '@/shared/components/typography/Text';

interface Props {
  service: TenantService;
  currency?: string;
}

const { service, currency = '$' } = Astro.props;
const { imageUrl, name, durationMinutes, price } = service;
---

<li
  class="flex cursor-pointer items-center justify-between gap-4 overflow-hidden rounded-2xl border border-gray-200 bg-white p-3 transition-all duration-200"
>
  <div class="flex items-center gap-4">
    <div
      class="flex size-14 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-100 bg-gray-100"
    >
      {
        imageUrl ? (
          <img src={imageUrl} alt={name} class="size-full object-cover" />
        ) : (
          <ScissorsIcon className="size-6 text-gray-400" />
        )
      }
    </div>

    <div class="flex-1 space-y-1.5">
      <div class="mb-2 flex flex-wrap items-center gap-4">
        <Text as="p" size="base" variant="default" className="leading-4"
          >{name}</Text
        >
        <div class="flex items-center gap-1.5">
          <Text as="span" variant="muted" size="sm">{durationMinutes} min</Text>
        </div>
      </div>
      <Text
        as="p"
        weight="medium"
        variant="default"
        size="base"
        className="leading-4">{currency}{price}</Text
      >
    </div>
  </div>

  <div>
    <Button type="button" size="sm" variant="outline" className="bg-white"
      >Reservar</Button
    >
  </div>
</li>
