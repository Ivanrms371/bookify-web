---
import { Accordion, type AccordionItem } from '@/components/ui/Accordion';
import { Heading } from '@/shared/components/typography/Heading';

const policyItems: AccordionItem[] = [
  {
    id: 'instant-booking',
    title: '¿Cómo funciona la reserva instantánea?',
    content:
      'Selecciona tu servicio, profesional y horario de preferencia. Tu turno queda agendado y confirmado automáticamente en el sistema.',
  },
  {
    id: 'cancellation',
    title: '¿Puedo cancelar o reprogramar mi cita?',
    content:
      'Sí, puedes modificar la fecha y hora o cancelar tu cita en cualquier momento desde el enlace de confirmación con anticipación.',
  },
  {
    id: 'payment-methods',
    title: '¿Cómo y cuándo se realiza el pago?',
    content:
      'El pago se realiza directamente en el establecimiento al momento de tu atención (efectivo, transferencia o tarjeta según disponibilidad del local).',
  },
  {
    id: 'punctuality',
    title: '¿Cuál es la tolerancia de llegada?',
    content:
      'Te recomendamos llegar 5 minutos antes de la hora fijada. Se cuenta con una tolerancia de hasta 10 minutos para cuidar el tiempo de todos los clientes.',
  },
];
---

<div class="mb-4">
  <Heading size="lg" as="h2">Información de la Reserva</Heading>
</div>

<Accordion
  client:visible
  items={policyItems}
  itemClassName="py-5 bg-white px-4 first:rounded-t-2xl last:rounded-b-2xl first:border-t last:border-b border-x border-gray-200"
/>
