---
import type { TenantPublicData } from '@/types/tenant';

const { tenant } = Astro.props as {
  tenant: TenantPublicData;
};

const { coverUrl, name, logoUrl } = tenant;
---

<header class="w-full pt-4">
  <div
    class="relative h-64 w-full overflow-hidden rounded-4xl shadow-xl sm:h-80 md:h-96"
  >
    {
      coverUrl ? (
        <img
          src={coverUrl}
          class="h-full w-full object-cover"
          alt={`${name} cover`}
        />
      ) : (
        <div class="h-full w-full bg-linear-to-r from-gray-900 via-indigo-950 to-indigo-900" />
      )
    }
    <div
      class="absolute inset-0 bg-linear-to-t from-black/80 via-transparent to-transparent"
    >
    </div>

    {
      logoUrl ? (
        <div class="absolute right-0 bottom-0 mr-10 mb-10">
          <img
            src={logoUrl}
            alt={name}
            class="h-32 w-32 rounded-full object-cover"
          />
        </div>
      ) : (
        <div class="absolute right-0 bottom-0 mr-10 mb-10">
          <div class="flex size-32 items-center justify-center rounded-full bg-gray-100 text-4xl font-semibold text-gray-800">
            {name
              .split(' ')
              .map((word) => word[0])
              .join('')
              .toUpperCase()}
          </div>
        </div>
      )
    }
  </div>
</header>
