---
const currentYear = new Date().getFullYear();
---

<footer
  class="mt-26 border-t border-gray-200/80 py-10 text-center text-sm text-gray-500"
>
  <div
    class="mx-auto flex max-w-screen-2xl flex-col items-center justify-between gap-4 text-sm text-gray-600 sm:flex-row"
  >
    <p>
      &copy; {currentYear} Bookify. Todos los derechos reservados.
    </p>

    <p class="flex items-center gap-1">
      <span>Powered by</span>
      <a
        href="https://bookify.com"
        target="_blank"
        rel="noopener noreferrer"
        class="font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 transition hover:text-indigo-600 hover:decoration-indigo-600"
      >
        Bookify
      </a>
    </p>
  </div>
</footer>
