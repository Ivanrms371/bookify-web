---
import Section from '@/components/ui/Section.astro';
import SectionEyebrow from '@/components/ui/SectionEyebrow.astro';
import { FAQ } from '@/components/marketing/FAQ';
import { QuestionMarkCircleIcon } from '@heroicons/react/24/outline';
import { Heading } from '@/shared/components/typography/Heading';
import { Text } from '@/shared/components/typography/Text';
---

<Section id="faq" class="py-24 lg:py-32">
  <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
    <!-- Left Column: Header & Support Info -->
    <div class="flex flex-col items-start gap-6 lg:col-span-5">
      <SectionEyebrow>
        <QuestionMarkCircleIcon className="size-4.5 text-indigo-600" />
        Preguntas frecuentes
      </SectionEyebrow>

      <Heading size="display" className="">
        Resolvemos las dudas más frecuentes.
      </Heading>

      <Text size="lg" variant="muted">
        ¿Tienes dudas sobre cómo Bookify puede adaptarse a tu flujo de trabajo?
        Aquí recopilamos las respuestas más habituales.
      </Text>
    </div>

    <!-- Right Column: Accordion -->
    <div class="rounded-3xl lg:col-span-7">
      <FAQ client:load />
    </div>
  </div>
</Section>
