---
import { Button } from '@/components/ui/Button';
import { ArrowRightIcon } from '@heroicons/react/20/solid';
---

<header class="sticky top-0 z-50 w-full bg-gray-50/80 backdrop-blur-lg">
  <nav
    class="mx-auto flex h-18 max-w-7xl items-center justify-between px-6 py-5"
  >
    <div class="flex-1">
      <a href="/" class="text-3xl font-semibold tracking-tighter">
        Book
        <span class="font-bold text-indigo-600">ify</span>
      </a>
    </div>

    <div class="hidden items-center gap-8 md:flex">
      <a
        href="#features"
        class="text-sm font-medium text-gray-700 transition hover:text-indigo-600"
      >
        Características
      </a>

      <a
        href="#how-it-works"
        class="text-sm font-medium text-gray-700 transition hover:text-indigo-600"
      >
        Cómo funciona
      </a>

      <a
        href="#pricing"
        class="text-sm font-medium text-gray-700 transition hover:text-indigo-600"
      >
        Precios
      </a>

      <a
        href="#faq"
        class="text-sm font-medium text-gray-700 transition hover:text-indigo-600"
      >
        Preguntas frecuentes
      </a>
    </div>

    <div class="hidden flex-1 items-center justify-end gap-2 md:flex">
      <Button as="a" href="/login" size="sm" variant="ghost">
        Iniciar sesión
      </Button>

      <Button as="a" href="/register" size="sm" variant="primary">
        Crear cuenta gratis
        <ArrowRightIcon className="size-4 text-white" />
      </Button>
    </div>
  </nav>
</header>
