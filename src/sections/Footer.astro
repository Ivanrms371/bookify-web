---
import { Text } from '@/shared/components/typography/Text';
import { FooterLink } from '@/components/marketing/FooterLink';

const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Producto',
    links: [
      { label: 'Características', href: '#features' },
      { label: 'Cómo funciona', href: '#how-it-works' },
      { label: 'Precios', href: '#pricing' },
      { label: 'Preguntas frecuentes', href: '#faq' },
    ],
  },
  {
    title: 'Acceso',
    links: [
      { label: 'Iniciar sesión', href: '/login' },
      { label: 'Crear cuenta', href: '/register' },
    ],
  },
  {
    title: 'Soporte',
    links: [
      { label: 'Términos y condiciones', href: '#' },
      { label: 'Política de privacidad', href: '#' },
    ],
  },
];
---

<footer class="mt-32 border-t border-gray-200/80 bg-gray-50">
  <div class="mx-auto max-w-7xl px-6 py-12 lg:py-16">
    <div class="grid grid-cols-1 gap-10 md:grid-cols-4 lg:grid-cols-5">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a
          href="/"
          class="text-3xl font-semibold tracking-tighter text-gray-900"
        >
          Book<span class="font-bold text-indigo-600">ify</span>
        </a>
      </div>

      <!-- Navigation Columns -->
      {
        footerSections.map((section) => (
          <div>
            <Text
              as="div"
              variant="default"
              size="base"
              className="font-medium"
            >
              {section.title}
            </Text>
            <ul class="mt-4 space-y-3">
              {section.links.map((link) => (
                <li>
                  <FooterLink label={link.label} href={link.href} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Bottom bar: Derechos y Powered by -->
    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-gray-100 pt-8 text-sm text-gray-700 sm:flex-row"
    >
      <p>
        &copy; {currentYear} Bookify. Todos los derechos reservados.
      </p>

      <p class="flex items-center gap-1">
        <span>Powered by</span>
        <a
          href="https://ivexusstudio.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-medium text-gray-700 underline decoration-gray-300 underline-offset-4 transition hover:text-indigo-600 hover:decoration-indigo-600"
        >
          Ivexus Studio
        </a>
      </p>
    </div>
  </div>
</footer>
