---
import { cn } from '@/shared/utils/cn';

interface Props {
  class?: string;
  containerClass?: string;
  id?: string;
}

const { class: className, containerClass, id } = Astro.props;
---

<section class={cn('py-16', className)} id={id}>
  <div class={cn('mx-auto w-full max-w-7xl px-4', containerClass)}>
    <slot />
  </div>
</section>
