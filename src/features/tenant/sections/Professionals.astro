---
import type { TenantProfessional } from '@/types/tenant';
import { Heading } from '@/shared/components/typography/Heading';
import { ProfessionalsList } from '@/features/professionals/components/ProfessionalsList';

interface Props {
  professionals: TenantProfessional[];
}

const { professionals } = Astro.props;
---

<div class="mb-12">
  <div class="mb-4">
    <Heading as="h2" size="lg"> Equipo </Heading>
  </div>

  <ProfessionalsList professionals={professionals} />
</div>
