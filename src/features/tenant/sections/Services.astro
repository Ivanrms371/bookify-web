---
import type { TenantService } from '@/types/tenant';
import { Heading } from '@/shared/components/typography/Heading';
import { Text } from '@/shared/components/typography/Text';
import { ServicesList } from '@/features/services/components/ServicesList';

interface Props {
  services: TenantService[];
  currency?: string;
}

const { services, currency = '$' } = Astro.props;
---

<div class="mb-12">
  <div class="mb-4">
    <Heading size="lg" as="h2"> Servicios </Heading>
  </div>

  {
    services.length === 0 ? (
      <Text as="p" variant="muted" size="base">
        No hay servicios disponibles actualmente.
      </Text>
    ) : (
      <ServicesList services={services} client:load/>
    )
  }
</div>
